{
    "name": "petzsch/laravel-btcpay",
    "description": "BtcPay wrapper for laravel",
    "keywords": [
        "btcpay",
        "BTC",
        "laravel"
    ],
    "homepage": "https://github.com/petzsch/laravel-btcpay",
    "license": "MIT",
    "authors": [
        {
            "name": "Vaibhavraj Roham",
            "email": "vaibhavraj@vrajroham.me",
            "homepage": "https://vrajroham.me",
            "role": "Developer"
        },
        {
            "name": "Alex Stewart",
            "email": "iamalexstewart@gmail.com",
            "homepage": "https://github.com/alexstewartja",
            "role": "Developer"
        },
        {
            "name": "Markus Petzsch",
            "email": "markus@petzsch.eu",
            "homepage": "https://www.petzsch.eu",
            "role": "Developer"
      }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "021/api-entity": "^2.1",
        "btcpayserver/btcpayserver-greenfield-php": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.5",
        "rector/rector": "^2.1.2",
        "symplify/easy-coding-standard": "^12.5",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "laravel/framework": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Petzsch\\LaravelBtcpay\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Petzsch\\LaravelBtcpay\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "lint:fix": "vendor/bin/ecs check src tests --fix"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Petzsch\\LaravelBtcpay\\BTCPayServiceProvider"
            ],
            "aliases": {
                "BTCPay": "Petzsch\\LaravelBtcpay\\Support\\BTCPay"
            }
        }
    }
}
